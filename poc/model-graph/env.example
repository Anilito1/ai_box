# Fournisseurs réels du POC (facultatif : sans ce fichier, le POC tourne en mode simulé).
# Copie ce fichier sous le nom « .env » dans ce dossier : il est ignoré par git, ne le commite jamais.
# De 1 à 9 fournisseurs ; chacun est une adresse compatible OpenAI (…/v1) et sa clé.

POC_PROVIDER_1_NAME=Venice
POC_PROVIDER_1_URL=https://api.venice.ai/api/v1
POC_PROVIDER_1_KEY=

POC_PROVIDER_2_NAME=DeepSeek
POC_PROVIDER_2_URL=https://api.deepseek.com/v1
POC_PROVIDER_2_KEY=

# Port du serveur local (4517 par défaut).
# POC_PORT=4517
